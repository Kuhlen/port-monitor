import { Theme } from "../../theme.slint";
import { MonitorState } from "monitor_state.slint";
import { Btn } from "controls.slint";

// pushes content down, never overlays the log (spec §3.2)
export component ErrorBanner inherits Rectangle {
    height: 48px;
    background: Theme.banner-bg;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.banner-border; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text { text: MonitorState.banner-title; font-size: 12px; font-weight: 600; color: Theme.banner-title; overflow: elide; }
            Text { text: MonitorState.banner-hint; font-size: 11px; color: Theme.banner-hint; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                text: "Retry";
                font-size: 12px;
                border-color: #8a5249;
                text-color: #ffc2b8;
                clicked => { MonitorState.retry(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: dismiss.has-hover ? #ffffff14 : transparent;
                Image { source: @image-url("../../../assets/icons/close.svg"); }
                dismiss := TouchArea { clicked => { MonitorState.dismiss-banner(); } }
            }
        }
    }
}
